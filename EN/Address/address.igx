<?xml version="1.0"?><IG xmlns="" version="1.0" streamversion="202607301336" exeversion="15.0.0 Build 57514" project="Address.prjx" Server="" Namespace="{019FB3A6-E2F4-7FA2-9FD1-AD2F600926F2}" ItemVersion="0" Locale="en-US" ModelValidatedOn="20260730 210531.964" ModelValidatedErrors="0" ModelValidatedWarnings="0" ModelValidatedHints="0"><INFO><Description></Description><Author></Author><File></File><Name>address</Name><Project>Address.prjx</Project><CreatedOn>20260730 173126.431</CreatedOn><UpdatedOn>20260730 210617.259</UpdatedOn></INFO><TABLE Name="OTFT"><META><COLUMN Name="OTFT Name" Type="CHARACTER" Width="254"/><COLUMN Name="Alias" Type="CHARACTER" Width="254"/><COLUMN Name="Type" Type="CHARACTER" Width="1"/><COLUMN Name="Derivable?" Type="BOOLEAN"/><COLUMN Name="Subtype?" Type="BOOLEAN"/><COLUMN Name="Data Type" Type="CHARACTER" Width="254"/><COLUMN Name="Length" Type="INTEGER"/><COLUMN Name="Scale" Type="INTEGER"/><COLUMN Name="Reducable?" Type="BOOLEAN"/><COLUMN Name="Reduce!" Type="BOOLEAN"/><COLUMN Name="Comment" Type="CHARACTER" Width="1024"/><COLUMN Name="SyncLink" Type="CHARACTER" Width="38"/><COLUMN Name="Artificial Key" Type="BOOLEAN"/><COLUMN Name="Estimated number of Tuples" Type="INTEGER"/><COLUMN Name="Static population" Type="BOOLEAN"/><COLUMN Name="Namespace" Type="CHARACTER" Width="38"/><COLUMN Name="NamespaceVersion" Type="INTEGER"/><COLUMN Name="Is super type" Type="BOOLEAN"/><COLUMN Name="Is abstract type" Type="BOOLEAN"/><COLUMN Name="OTFT Schema" Type="CHARACTER" Width="254"/><COLUMN Name="Abbreviation" Type="CHARACTER" Width="254"/><COLUMN Name="OTFT Plural" Type="CHARACTER" Width="254"/><COLUMN Name="Temporal" Type="CHARACTER" Width="35"/><COLUMN Name="Transitional" Type="BOOLEAN"/><COLUMN Name="Concept Type" Type="CHARACTER" Width="254"/><COLUMN Name="Task Status" Type="CHARACTER" Width="254"/><COLUMN Name="Task Color" Type="CHARACTER" Width="254"/><COLUMN Name="Task Background" Type="CHARACTER" Width="254"/><COLUMN Name="Localize Value" Type="BOOLEAN"/><COLUMN Name="Image URI" Type="CHARACTER" Width="254"/><COLUMN Name="Meta Level" Type="CHARACTER" Width="1"/><COLUMN Name="Authoritative Synclink" Type="CHARACTER" Width="38"/><COLUMN Name="Case Sensitive" Type="BOOLEAN"/><COLUMN Name="Annotatable" Type="BOOLEAN"/><COLUMN Name="IsComplexType" Type="BOOLEAN"/><COLUMN Name="OTFT Article" Type="CHARACTER" Width="20"/><COLUMN Name="IsComposite" Type="BOOLEAN"/><COLUMN Name="Sensitivity" Type="CHARACTER" Width="20"/><COLUMN Name="Retention Policy" Type="CHARACTER" Width="20"/><COLUMN Name="Created By" Type="CHARACTER" Width="128"/><COLUMN Name="Created On" Type="anyType"/><COLUMN Name="Updated By" Type="CHARACTER" Width="128"/><COLUMN Name="Updated On" Type="anyType"/></META><DATA><ROW><FIELD Name="OTFT Name">Address</FIELD><FIELD Name="Alias"></FIELD><FIELD Name="Type">N</FIELD><FIELD Name="Derivable?">F</FIELD><FIELD Name="Subtype?">F</FIELD><FIELD Name="Data Type"></FIELD><FIELD Name="Length"></FIELD><FIELD Name="Scale"></FIELD><FIELD Name="Reducable?"></FIELD><FIELD Name="Reduce!"></FIELD><FIELD Name="Comment">[Definition]
A designation by which a location can be identified for delivery, legal or administrative purposes. Identified by an opaque surrogate (Address Code) - not a value, not a composite key, not a per-country type. Every real identification scheme in the world (postcode+number, Eircode, UPRN, chome/banchi/go) is a FACT ABOUT an address, not the address itself; making any of them the identifier imports one jurisdiction assumptions into the identity of the concept. What is universally true of an address is only this: it has an identity, it is in a country, it follows some addressing paradigm, and it can be rendered as an ordered sequence of lines.</FIELD><FIELD Name="SyncLink">019FB3A6-F9D8-7BEC-B6B0-A9E845EB43F1</FIELD><FIELD Name="Artificial Key"></FIELD><FIELD Name="Estimated number of Tuples"></FIELD><FIELD Name="Static population"></FIELD><FIELD Name="Namespace"></FIELD><FIELD Name="NamespaceVersion"></FIELD><FIELD Name="Is super type">T</FIELD><FIELD Name="Is abstract type"></FIELD><FIELD Name="OTFT Schema"></FIELD><FIELD Name="Abbreviation"></FIELD><FIELD Name="OTFT Plural"></FIELD><FIELD Name="Temporal">Valid Time</FIELD><FIELD Name="Transitional"></FIELD><FIELD Name="Concept Type"></FIELD><FIELD Name="Task Status">Develop</FIELD><FIELD Name="Task Color"></FIELD><FIELD Name="Task Background"></FIELD><FIELD Name="Localize Value"></FIELD><FIELD Name="Image URI"></FIELD><FIELD Name="Meta Level"></FIELD><FIELD Name="Authoritative Synclink">019FB3A6-F9D8-7022-BCEE-F0B72A3D5547</FIELD><FIELD Name="Case Sensitive"></FIELD><FIELD Name="Annotatable"></FIELD><FIELD Name="IsComplexType"></FIELD><FIELD Name="OTFT Article"></FIELD><FIELD Name="IsComposite"></FIELD><FIELD Name="Sensitivity"></FIELD><FIELD Name="Retention Policy"></FIELD><FIELD Name="Created By">mcp-agent</FIELD><FIELD Name="Created On">20260730 173132.440</FIELD><FIELD Name="Updated By">mcp-agent</FIELD><FIELD Name="Updated On">20260730 173211.295</FIELD></ROW><ROW><FIELD Name="OTFT Name">Address Admin Unit</FIEL
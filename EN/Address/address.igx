?"></FIELD><FIELD Name="Reduce!"></FIELD><FIELD Name="Comment"></FIELD><FIELD Name="SyncLink">019FB3A7-1716-7D0C-8BAE-9351DB41E5CE</FIELD><FIELD Name="Artificial Key"></FIELD><FIELD Name="Estimated number of Tuples"></FIELD><FIELD Name="Static population"></FIELD><FIELD Name="Namespace"></FIELD><FIELD Name="NamespaceVersion"></FIELD><FIELD Name="Is super type"></FIELD><FIELD Name="Is abstract type"></FIELD><FIELD Name="OTFT Schema"></FIELD><FIELD Name="Abbreviation"></FIELD><FIELD Name="OTFT Plural"></FIELD><FIELD Name="Temporal"></FIELD><FIELD Name="Transitional"></FIELD><FIELD Name="Concept Type"></FIELD><FIELD Name="Task Status"></FIELD><FIELD Name="Task Color"></FIELD><FIELD Name="Task Background"></FIELD><FIELD Name="Localize Value"></FIELD><FIELD Name="Image URI"></FIELD><FIELD Name="Meta Level"></FIELD><FIELD Name="Authoritative Synclink">019FB3A7-1716-7842-AF87-D0A461C3561A</FIELD><FIELD Name="Case Sensitive"></FIELD><FIELD Name="Annotatable"></FIELD><FIELD Name="IsComplexType"></FIELD><FIELD Name="OTFT Article"></FIELD><FIELD Name="IsComposite"></FIELD><FIELD Name="Sensitivity"></FIELD><FIELD Name="Retention Policy"></FIELD><FIELD Name="Created By">mcp-agent</FIELD><FIELD Name="Created On">20260730 173139.926</FIELD><FIELD Name="Updated By"></FIELD><FIELD Name="Updated On"></FIELD></ROW><ROW><FIELD Name="OTFT Name">Dutch Postcode</FIELD><FIELD Name="Alias"></FIELD><FIELD Name="Type">L</FIELD><FIELD Name="Derivable?"></FIELD><FIELD Name="Subtype?">F</FIELD><FIELD Name="Data Type">string</FIELD><FIELD Name="Length"></FIELD><FIELD Name="Scale"></FIELD><FIELD Name="Reducable?"></FIELD><FIELD Name="Reduce!"></FIELD><FIELD Name="Comment">Value pattern /^[1-9][0-9]{3}[A-Z]{2}$/. DR1/DR2: thoroughfare and administrative unit/place are CONSEQUENCES of postcode plus premise number, not independent facts - storing them as independent roles guarantees a reconciliation backlog that never empties. Composite identification (UC2) for a Dutch thoroughfare address is {postcode, premise number, premise number addition}: an identification spanning three fact types, which is not placeable as one intra-fact UC.</FIELD><FIELD Name="SyncLink">019FB3A7-11A7-780D-8D41-99B232D49374</FIELD><FIELD Name="Artificial Key"></FIELD><FIELD Name="Estimated number of Tuples"></FIELD><FIELD Name="Static population"></FIELD><FIELD Name="Namespace"></FIELD><FIELD Name="NamespaceVersion"></FIELD><FIELD Name="Is super type"></FIELD><FIELD Name="Is abstract type"></FIELD><FIELD Name="OTFT Schema"></FIELD><FIELD Name="Abbreviation"></FIELD><FIELD Name="OTFT Plural"></FIELD><FIELD Name="Temporal"></FIELD><FIELD Name="Transitional"></FIELD><FIELD Name="Concept Type"></FIELD><FIELD Name="Task Status"></FIELD><FIELD Name="Task Color"></FIELD><FIELD Name="Task Background"></FIELD><FIELD Name="Localize Value"></FIELD><FIELD Name="Image URI"></FIELD><FIELD Name="Meta Level"></FIELD><FIELD Name="Authoritative Synclink">019FB3A7-11A7-7A15-A0C7-8C6BA850EC09</FIELD><FIELD Name="Case Sensitive"></FIELD><FIELD Name="Annotatable"></FIELD><FIELD Name="IsComplexType"></FIELD><FIELD Name="OTFT Article"></FIELD><FIELD Name="IsComposite"></FIELD><FIELD Name="Sensitivity"></FIELD><FIELD Name="Retention Policy"></FIELD><FIELD Name="Created By">mcp-agent</FIELD><FIELD Name="Created On">20260730 173138.535</FIELD><FIELD Name="Updated By">mcp-agent</FIELD><FIELD Name="Updated On">20260730 173214.712</FIELD></ROW><ROW><FIELD Name="OTFT Name">Eircode</FIELD><FIELD Name="Alias"></FIELD><FIELD Name="Type">N</FIELD><FIELD Name="Derivable?">F</FIELD><FIELD Name="Subtype?">F</FIELD><FIELD Name="Data Type"></FIELD><FIELD Name="Length"></FIELD><FIELD Name="Scale"></FIELD><FIELD Name="Reducable?"></FIELD><FIELD Name="Reduce!"></FIELD><FIELD Name="Comment">Value pattern like H91 XY32. Uniquely identifies an address and is uniquely identified BY it - two separate uniqueness constraints. Townland is handled through Address Admin Unit with an Admin Level Kind of TOWNLAND.</FIELD><FIELD Name="SyncLi